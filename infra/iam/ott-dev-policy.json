{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DynamoOttTables",
      "Effect": "Allow",
      "Action": [
        "dynamodb:CreateTable", "dynamodb:DeleteTable", "dynamodb:DescribeTable", "dynamodb:TagResource",
        "dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem", "dynamodb:DeleteItem",
        "dynamodb:BatchGetItem", "dynamodb:BatchWriteItem", "dynamodb:Query"
      ],
      "Resource": [
        "arn:aws:dynamodb:eu-central-1:ACCOUNT_ID:table/ott-*",
        "arn:aws:dynamodb:ap-south-1:ACCOUNT_ID:table/ott-*"
      ]
    },
    {
      "Sid": "LambdaOttFunctions",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction", "lambda:DeleteFunction", "lambda:GetFunction", "lambda:GetFunctionConfiguration",
        "lambda:UpdateFunctionCode", "lambda:UpdateFunctionConfiguration",
        "lambda:InvokeFunction", "lambda:InvokeFunctionUrl",
        "lambda:CreateFunctionUrlConfig", "lambda:GetFunctionUrlConfig", "lambda:DeleteFunctionUrlConfig",
        "lambda:PutFunctionConcurrency", "lambda:DeleteFunctionConcurrency", "lambda:GetFunctionConcurrency",
        "lambda:TagResource", "lambda:ListTags"
      ],
      "Resource": [
        "arn:aws:lambda:eu-central-1:ACCOUNT_ID:function:ott-*",
        "arn:aws:lambda:ap-south-1:ACCOUNT_ID:function:ott-*"
      ]
    },
    {
      "Sid": "LogsOttGroups",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup", "logs:DeleteLogGroup", "logs:PutRetentionPolicy", "logs:TagResource",
        "logs:FilterLogEvents", "logs:GetLogEvents", "logs:DescribeLogStreams"
      ],
      "Resource": [
        "arn:aws:logs:eu-central-1:ACCOUNT_ID:log-group:/aws/lambda/ott-*",
        "arn:aws:logs:eu-central-1:ACCOUNT_ID:log-group:/aws/lambda/ott-*:*",
        "arn:aws:logs:ap-south-1:ACCOUNT_ID:log-group:/aws/lambda/ott-*",
        "arn:aws:logs:ap-south-1:ACCOUNT_ID:log-group:/aws/lambda/ott-*:*"
      ]
    },
    {
      "Sid": "SsmOttParameters",
      "Effect": "Allow",
      "Action": ["ssm:PutParameter", "ssm:GetParameter", "ssm:DeleteParameter", "ssm:AddTagsToResource"],
      "Resource": [
        "arn:aws:ssm:eu-central-1:ACCOUNT_ID:parameter/ott/*",
        "arn:aws:ssm:ap-south-1:ACCOUNT_ID:parameter/ott/*"
      ]
    },
    {
      "Sid": "PassTheOneLambdaRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/ott-recsys-lambda-role",
      "Condition": {"StringEquals": {"iam:PassedToService": "lambda.amazonaws.com"}}
    },
    {
      "Sid": "DenyOutsideTheTwoRegions",
      "Effect": "Deny",
      "NotAction": ["iam:*", "sts:*"],
      "Resource": "*",
      "Condition": {"StringNotEquals": {"aws:RequestedRegion": ["eu-central-1", "ap-south-1"]}}
    },
    {
      "Sid": "DenyAnyIamWriteExceptPassRole",
      "Effect": "Deny",
      "Action": ["iam:Create*", "iam:Attach*", "iam:Detach*", "iam:Put*", "iam:Update*", "iam:Delete*", "iam:Add*", "iam:Remove*", "iam:Set*", "iam:Tag*", "iam:Untag*"],
      "Resource": "*"
    },
    {
      "Sid": "DenyCostlyServices",
      "Effect": "Deny",
      "Action": ["ec2:*", "lambda:PutProvisionedConcurrencyConfig", "dynamodb:CreateGlobalTable", "dynamodb:UpdateGlobalTable", "dynamodb:CreateBackup"],
      "Resource": "*"
    }
  ]
}
